# Шаблон переменных окружения. Скопируйте в .env и заполните реальными
# значениями. Файл .env не должен попадать в систему контроля версий.
# ВАЖНО: ключи, ранее захардкоженные в коде, считайте скомпрометированными
# и выпустите новые.

# --- База данных ---
# Локальная разработка без Docker (SQLite):
# DATABASE_URL=sqlite:///./bpmn.db
# Docker Compose / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@db:5432/bpmn
# Пароль пользователя БД для docker-compose:
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT ---
# Обязательно для PostgreSQL; сгенерируйте, например:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Почта (приглашения, сброс пароля) ---
# MAIL_FROM обязан быть валидным e-mail (с @): ConnectionConfig валидирует
# формат при импорте main.py, пустое значение ломает запуск. Пока реальный
# SMTP не настроен — оставьте placeholder.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vkusvill.ru
MAIL_PORT=465
MAIL_SERVER=imap.yandex.ru
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- LLM-провайдер (Foundation Models API, OpenAI-совместимый) ---
LLM_API_KEY=
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=openai/gpt-oss-120b
TOGETHER_API_KEY=

# --- Frontend-сборка ---
# Адрес backend, доступный из БРАУЗЕРА пользователя:
REACT_APP_API_URL=http://localhost:8765

# --- Порты локального запуска (python main.py / npm start) ---
# Хост-порты 8000/3000 на рабочей машине заняты сторонними проектами.
BACKEND_PORT=8765
FRONTEND_URL=http://localhost:3456
