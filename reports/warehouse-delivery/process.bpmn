<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:process id="Process_1" isExecutable="true"><bpmn:laneSet id="LaneSet_1"><bpmn:lane id="L1" name="Оператор склада"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L4" name="Кладовщик"><bpmn:flowNodeRef>A3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L5" name="Контролёр качества"><bpmn:flowNodeRef>A4</bpmn:flowNodeRef><bpmn:flowNodeRef>A5</bpmn:flowNodeRef><bpmn:flowNodeRef>A6</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L6" name="Служба логистики"><bpmn:flowNodeRef>A7</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L8" name="Экспедитор"><bpmn:flowNodeRef>A10</bpmn:flowNodeRef><bpmn:flowNodeRef>A11</bpmn:flowNodeRef><bpmn:flowNodeRef>A12</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S1" name="Формирование заявки оператором склада"><bpmn:outgoing>Flow_S1_A3</bpmn:outgoing><bpmn:outgoing>Flow_S1_A10</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="A3" name="Сборка груза кладовщиком"><bpmn:incoming>Flow_S1_A3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="A4" name="Проверка целостности упаковки и пломб контролёром качества"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask><bpmn:task id="A5" name="Условие прохождения проверки"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:task><bpmn:userTask id="A6" name="Пересборка груза"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>Flow_A6_A12</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="A7" name="Заказ транспорта службой логистики"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>Flow_A7_A12</bpmn:outgoing></bpmn:userTask><bpmn:receiveTask id="A10" name="Фиксация подписи экспедитором"><bpmn:incoming>Flow_S1_A10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:r