static/*
!static/vkusvill_logo.png

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Frontend
node_modules/
bpmn-constructor/build/
bpmn-constructor/coverage/
npm-debug.log*

# Логи
*.log

# IDE / окружение агентов
.vs/
.vscode/
.idea/
.qoder/

