n:sequenceFlow id="Flow_StartEvent_2_A1" sourceRef="StartEvent_2" targetRef="A1" /><bpmn:sequenceFlow id="Flow_A1_EndEvent_2" sourceRef="A1" targetRef="EndEvent_2" /></bpmn:process><bpmn:process id="Process_3" isExecutable="true"><bpmn:laneSet id="LaneSet_3"><bpmn:lane id="L3" name="Комплектатор"><bpmn:flowNodeRef>StartEvent_3</bpmn:flowNodeRef><bpmn:flowNodeRef>A2</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_3</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_3" name="Старт"><bpmn:outgoing>Flow_StartEvent_3_A2</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="A2" name="Сборка частичной отгрузки комплектатором"><bpmn:incoming>Flow_StartEvent_3_A2</bpmn:incoming><bpmn:outgoing>Flow_A2_EndEvent_3</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndEvent_3" name="Завершение"><bpmn:incoming>Flow_A2_EndEvent_3</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_StartEvent_3_A2" sourceRef="StartEvent_3" targetRef="A2" /><bpmn:sequenceFlow id="Flow_A2_EndEvent_3" sourceRef="A2" targetRef="EndEvent_3" /></bpmn:process><bpmn:process id="Process_4" isExecutable="true"><bpmn:startEvent id="StartEvent_4" name="Старт"><bpmn:outgoing>Flow_StartEvent_4_EndEvent_4</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="EndEvent_4" name="Завершение"><bpmn:incoming>Flow_StartEvent_4_EndEvent_4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_StartEvent_4_EndEvent_4" sourceRef="StartEvent_4" targetRef="EndEvent_4" /></bpmn:process><bpmn:process id="Process_5" isExecutable="true"><bpmn:startEvent id="StartEvent_5" name="Старт"><bpmn:outgoing>Flow_StartEvent_5_EndEvent_5</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="EndEvent_5" name="Завершение"><bpmn:incoming>Flow_StartEvent_5_EndEvent_5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_StartEvent_5_EndEvent_5" sourceRef="StartEvent_5" targetRef="EndEvent_5" /></bpmn:process><bpmn:process id="Process_6" isExecutable="true"><bpmn:startEvent id="StartEvent_6" name="Старт"><bpmn:outgoing>Flow_StartEvent_6_EndEvent_6</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="EndEvent_6" name="Завершение"><bpmn:incoming>Flow_StartEvent_6_EndEvent_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_StartEvent_6_EndEvent_6" sourceRef="StartEvent_6" targetRef="EndEvent_6" /></bpmn:process><bpmn:process id="Process_7" isExecutable="true"><bpmn:laneSet id="LaneSet_7"><bpmn:lane id="L7" name="Водитель"><bpmn:flowNodeRef>StartEvent_7</bpmn:flowNodeRef><bpmn:flowNodeRef>A8</bpmn:flowNodeRef><bpmn:flowNodeRef>A9</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_7</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_7" name="Старт"><bpmn:outgoing>Flow_StartEvent_7_A8</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="A8" name="Получение путевого листа водителем"><bpmn:incoming>Flow_StartEvent_7_A8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:sendTask><bpmn:scriptTask id="A9" name="Забор груза водителем"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>Flow_A9_EndEvent_7</bpmn:outgoing></bpmn:scriptTask><bpmn:endEvent id="EndEvent_7" name="Завершение"><bpmn:incoming>Flow_A9_EndEvent_7</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F9" sourceRef="A8" targetRef="A9" /><bpmn:sequenceFlow id="Flow_StartEvent_7_A8" sourceRef="StartEvent_7" targetRef="A8" /><bpmn:sequenceFlow id="Flow_A9_EndEvent_7" sourceRef="A9" targetRef="EndEvent_7" /></bpmn:process><bpmn:process id="Process_8" isExecutable="true"><bpmn:startEvent id="StartEvent_8" name="Старт"><bpmn:outgoing>Flow_StartEvent_8_EndEvent_8</bpmn:outgoing></bpmn:startEvent><bpmn:endEvent id="EndEvent_8" name="Завершение"><bpmn:incoming>Flow_StartEvent_8_EndEvent_8</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_StartEvent_8_EndEvent_8" sourceRef="StartEvent_8" targetRef="EndEvent_8" /></bpmn:process><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_1" name="Склад" processRef="Process_1" /><bpmn:participant id="Participant_2" name="WMS" p