# Шаблон переменных окружения. Скопируйте в .env и заполните реальными
# значениями. Файл .env не должен попадать в систему контроля версий.
# ВАЖНО: ключи, ранее захардкоженные в коде, считайте скомпрометированными
# и выпустите новые.

# --- База данных ---
# Локальная разработка без Docker (SQLite):
# DATABASE_URL=sqlite:///./bpmn.db
# Docker Compose / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@db:5432/bpmn
# Пароль пользователя БД для docker-compose:
POSTGRES_PASSWORD=CHANGE_ME
# Пул соединений PostgreSQL (читает app/db.py). ИИ-маршрут держит соединение
# на весь вызов модели, поэтому пул рассчитан на десяток одновременных
# улучшений с запасом; total = DB_POOL_SIZE + DB_MAX_OVERFLOW обязан быть
# меньше max_connections сервера (у PostgreSQL по умолчанию 100).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# SQLite: миллисекунды ожидания блокировки файла перед ошибкой
# «database is locked» (PRAGMA busy_timeout).
SQLITE_BUSY_TIMEOUT_MS=5000

# --- JWT ---
# Обязательно для PostgreSQL; сгенерируйте, например:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Почта (приглашения, сброс пароля) ---
# MAIL_FROM обязан быть валидным e-mail (с @): ConnectionConfig валидирует
# формат при импорте main.py, пустое значение ломает запуск. Пока реальный
# SMTP не настроен — оставьте placeholder.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vkusvill.ru
MAIL_PORT=465
MAIL_SERVER=imap.yandex.ru
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- LLM-провайдер (GigaChat, библиотека gigachat) ---
# credentials — base64 от «client_id:client_secret» из личного кабинета Sber Cloud
# (Scope «GIGACHAT_API_PERS» для физлиц, «GIGACHAT_API_CORP» для организаций).
# Значение — только в .env; в репозиторий попадает этот шаблон с CHANGE_ME.
GIGACHAT_CREDENTIALS=CHANGE_ME
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# false отключает проверку TLS: сертификат GigaChat выдан российским УЦ, которого
# нет в доверенных корнях Windows/Alpine. Оставлять false в проде нельзя —
# вместо этого укажите CA-bundle и верните true.
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE_FILE=/path/to/rus-trust-ca.pem
# GIGACHAT_MODEL — имя модели старого API («GigaChat») новый шлюз
# api.giga.chat не знает: отвечает 404 «No such model», и повтор его не лечит.
# Пусто = пул по умолчанию из core/llm_client.py (GigaChat-2,
# GigaChat-3-Lightning); через запятую — свой порядок, следующую модель просят,
# когда провайдер не знает текущей.
GIGACHAT_MODEL=
# Scope GIGACHAT_API_PERS и GIGACHAT_API_B2B разрешают один одновременный
# запрос: лишние параллельные вызовы провайдер отбивает 429. Поднимайте только
# на тарифе с большей параллельностью.
GIGACHAT_MAX_CONCURRENT=1
# Путь к кэшу RAG-индекса (.npz + JSON-манифест), читает core/llm_improve.py.
# По умолчанию рядом с кодом: core/bpmn_rag_cache.npz
# BPMN_RAG_CACHE_FILE=/var/tmp/bpmn_rag_cache.npz
# Служебный режим запуска (читает app/config.py): =1 пропускает инициализацию
# LLM-оркестратора в lifespan — ИИ-эндпоинты отвечают 503, реестр и доступ
# работают. Нужен для переноса данных и прогонов без ключей; на обычном
# запуске оставляйте пустым.
SKIP_LLM_INIT=

# --- CORS ---
# Список разрешённых источников через запятую (читает app/config.py,
# применяет app/main.py вместе с allow_credentials). Пусто = только
# FRONTEND_URL; локальная dev-связка так и работает без настройки.
CORS_ORIGINS=

# --- Лимиты ИИ-контура ---
# Максимальный размер BPMN XML в запросах скоринга и улучшения (символов).
AI_MAX_XML_CHARS=1000000
# Максимальный размер загружаемого в реестр .bpmn/.xml файла, байт.
MAX_UPLOAD_BYTES=2000000
# Часовой бюджет ИИ-запросов на пользователя (генерация, скоринг, улучшение).
# Счётчик локален для процесса: при нескольких репликах нужен общий (Redis).
AI_REQUESTS_PER_HOUR=60

# --- Бюджеты ИИ-контура ---
# Сколько попыток и ожидания разрешено на ОДИН вызов модели (транспорт,
# core/llm_client.py). Разные модели пула перебираются внутри этого же бюджета.
GIGACHAT_CALL_BUDGET_SECONDS=600
# Потолок времени на ВСЮ генерацию: до десяти завершений с учётом переспроса,
# вопроса о принадлежности и repair-повторов, в очереди к провайдеру. При
# исчерпании — различимая ошибка, а не недоделанная схема (core/bpmn_generator.py).
BPMN_GENERATION_BUDGET_SECONDS=900
# Файл кэша RAG-индекса эталонов (пусто — рядом с кодом). Пересобирается по
# хешу содержимого корпуса, см. corpus_fingerprint в core/llm_improve.py.
BPMN_RAG_CACHE_FILE=
# Режим служебного запуска без ИИ (перенос данных): ИИ-эндпоинты отвечают 503.
SKIP_LLM_INIT=
# Стадия плана требует таймер и от ожидания БЕЗ срока («ждёт подрядчика»).
# По умолчанию нарушение показывается в gaps, но не заводит переспрос: расширенный
# список нарушений плодит переспросы, на которых модель теряет уже утверждённый
# состав (прогоны #59–#62). 1 — спрашивать всерьёз.
BPMN_GATE_WAIT_GAPS=0

# --- Троттлинг auth-маршрутов (окно 1 час, счётчик локален для процесса) ---
AUTH_LOGIN_PER_IP_EMAIL_MAX=10
AUTH_LOGIN_PER_EMAIL_MAX=30
AUTH_LOGIN_PER_IP_MAX=200
AUTH_REGISTER_PER_IP_MAX=50
AUTH_RESET_PER_EMAIL_MAX=5
AUTH_RESET_PER_IP_MAX=100

# --- Frontend-сборка ---
# Адрес backend, доступный из БРАУЗЕРА пользователя:
REACT_APP_API_URL=http://localhost:8765

# --- Порты локального запуска (python main.py / npm start) ---
# Хост-порты 8000/3000 на рабочей машине заняты сторонними проектами.
BACKEND_PORT=8765
FRONTEND_URL=http://localhost:3456

# --- Специфичные для прогона и переноса данных (обычно задаются в оболочке,
# а не в .env; перечислены, чтобы шаблон покрывал всё читаемое кодом) ---
# Тестовый прогон (tests/conftest.py): своя база, иначе тесты пишут в рабочую.
# TEST_DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@localhost:5432/bpmn_test
# Источник для migrate_sqlite_to_postgres.py: переносимая легаси-SQLite.
# SQLITE_URL=sqlite:///./bpmn.db
