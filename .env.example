# Шаблон переменных окружения. Скопируйте в .env и заполните реальными
# значениями. Файл .env не должен попадать в систему контроля версий.
# ВАЖНО: ключи, ранее захардкоженные в коде, считайте скомпрометированными
# и выпустите новые.

# --- База данных ---
# Локальная разработка без Docker (SQLite):
# DATABASE_URL=sqlite:///./bpmn.db
# Docker Compose / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@db:5432/bpmn
# Пароль пользователя БД для docker-compose:
POSTGRES_PASSWORD=CHANGE_ME
# Пул соединений PostgreSQL (читает app/db.py). ИИ-маршрут держит соединение
# на весь вызов модели, поэтому пул рассчитан на десяток одновременных
# улучшений с запасом; total = DB_POOL_SIZE + DB_MAX_OVERFLOW обязан быть
# меньше max_connections сервера (у PostgreSQL по умолчанию 100).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
# SQLite: миллисекунды ожидания блокировки файла перед ошибкой
# «database is locked» (PRAGMA busy_timeout).
SQLITE_BUSY_TIMEOUT_MS=5000

# --- JWT ---
# Обязательно для PostgreSQL; сгенерируйте, например:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Логи ---
# Уровень корневого логгера процесса (DEBUG, INFO, WARNING, ERROR). Настройка
# обязательна: под `uvicorn main:app` корень не сконфигурирован, и INFO-строки
# старта (режим очереди, backend бюджета, прогрев корпуса эталонов) в
# `docker logs` не появлялись вовсе. Строка журнала несёт идентификатор запроса
# в скобках — по нему собираются обратно все строки одного запроса; связи с
# воркером держатся по `task_id`, его печатает исполнитель задачи.
LOG_LEVEL=INFO

# --- Почта (приглашения, сброс пароля) ---
# MAIL_FROM обязан быть валидным e-mail (с @): ConnectionConfig валидирует
# формат при импорте main.py, пустое значение ломает запуск. Пока реальный
# SMTP не настроен — оставьте placeholder.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vkusvill.ru
MAIL_PORT=465
# SMTP, а не IMAP: `imap.yandex.ru` — адрес входящей почты, через него письмо
# о сбросе пароля не уходит никогда. Порт 465 — implicit TLS, поэтому SSL_TLS
# включён, а STARTTLS выключен: на 465 handshake со STARTTLS отвергается, и
# пользователь получает «письмо отправлено» без письма. Для 587 — наоборот
# (MAIL_PORT=587, MAIL_STARTTLS=true, MAIL_SSL_TLS=false).
MAIL_SERVER=smtp.yandex.ru
MAIL_STARTTLS=false
MAIL_SSL_TLS=true

# --- LLM-провайдер (GigaChat, библиотека gigachat) ---
# credentials — base64 от «client_id:client_secret» из личного кабинета Sber Cloud
# (Scope «GIGACHAT_API_PERS» для физлиц, «GIGACHAT_API_CORP» для организаций).
# Значение — только в .env; в репозиторий попадает этот шаблон с CHANGE_ME.
GIGACHAT_CREDENTIALS=CHANGE_ME
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# false отключает проверку TLS: сертификат GigaChat выдан российским УЦ, которого
# нет в доверенных корнях Windows/Alpine. Оставлять false в проде нельзя —
# вместо этого укажите CA-bundle и верните true.
# Порядок при обоих ключах: явный false СТАРШЕ bundle. Библиотека `gigachat`
# подставляет `verify = ca_bundle_file` поверх `verify_ssl_certs=False`, поэтому
# переданный при выключенной проверке файл молча ВЕРНУЛ бы проверку — а лог в этот
# момент утверждал бы обратное. Приложение передаёт файл только когда проверка
# включена, и при обоих ключах печатает отдельную строку о том, что bundle не
# подключается.
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE_FILE=/path/to/rus-trust-ca.pem
# GIGACHAT_MODEL — имя модели старого API («GigaChat») новый шлюз
# api.giga.chat не знает: отвечает 404 «No such model», и повтор его не лечит.
# Пусто = пул по умолчанию из core/llm_client.py (GigaChat-2-Max, GigaChat-2);
# через запятую — свой порядок, следующую модель просят,
# когда провайдер не знает текущей.
GIGACHAT_MODEL=
# Scope GIGACHAT_API_PERS и GIGACHAT_API_B2B разрешают один одновременный
# запрос: лишние параллельные вызовы провайдер отбивает 429. Поднимайте только
# на тарифе с большей параллельностью.
GIGACHAT_MAX_CONCURRENT=1
# Путь к кэшу RAG-индекса (.npz + JSON-манифест), читает core/llm_improve.py.
# По умолчанию рядом с кодом: core/bpmn_rag_cache.npz
# BPMN_RAG_CACHE_FILE=/var/tmp/bpmn_rag_cache.npz
# Служебный режим запуска (читает app/config.py; истина — 1/true/yes/on):
# пропускает инициализацию LLM-оркестратора в lifespan веб-процесса. Что при
# этом выключается, а что нет — зависит от режима: /api/ai/improve отвечает 503
# всегда (он держит оркестратор), а /api/generate и /api/evaluate в режиме без
# Redis продолжают работать, потому что генератор и скоринг — объекты другого
# слоя и оркестратора не просят. Нужен для переноса данных и прогонов без
# тяжёлых моделей; на обычном запуске оставляйте пустым. В режиме очереди
# (задан REDIS_URL) флаг теряет смысл для backend: тяжёлые модели живут в
# воркере, и ему он специально не передаётся (иначе выключал бы единственную
# работу воркера).
SKIP_LLM_INIT=

# --- CORS ---
# Список разрешённых источников через запятую (читает app/config.py,
# применяет app/main.py вместе с allow_credentials). Пусто = только
# FRONTEND_URL; локальная dev-связка так и работает без настройки.
CORS_ORIGINS=

# --- Лимиты ИИ-контура ---
# Максимальный размер BPMN XML в запросах скоринга и улучшения (символов).
AI_MAX_XML_CHARS=1000000
# Максимальный размер загружаемого в реестр .bpmn/.xml файла, байт.
MAX_UPLOAD_BYTES=2000000
# Часовой бюджет ИИ-запросов на пользователя (генерация, скоринг, улучшение).
# При заданном REDIS_URL окно общее на все реплики (app/deps.py); без него
# счётчик локален для процесса, то есть лимит умножается на число реплик.
AI_REQUESTS_PER_HOUR=60

# --- Бюджеты ИИ-контура ---
# Сколько попыток и ожидания разрешено на ОДИН вызов модели (транспорт,
# core/llm_client.py). Разные модели пула перебираются внутри этого же бюджета.
GIGACHAT_CALL_BUDGET_SECONDS=600
# Потолок времени на ВСЮ генерацию: до десяти завершений с учётом переспроса,
# вопроса о принадлежности и repair-повторов, в очереди к провайдеру. При
# исчерпании — различимая ошибка, а не недоделанная схема (core/bpmn_generator.py).
BPMN_GENERATION_BUDGET_SECONDS=900
# Файл кэша RAG-индекса эталонов (пусто — рядом с кодом). Пересобирается по
# хешу содержимого корпуса, см. corpus_fingerprint в core/llm_improve.py.
BPMN_RAG_CACHE_FILE=
# Стадия плана требует таймер и от ожидания БЕЗ срока («ждёт подрядчика»).
# По умолчанию нарушение показывается в gaps, но не заводит переспрос: расширенный
# список нарушений плодит переспросы, на которых модель теряет уже утверждённый
# состав (прогоны #59–#62). 1 — спрашивать всерьёз.
BPMN_GATE_WAIT_GAPS=0

# --- Redis: очередь задач и кэш ответов модели ---
# Пустой REDIS_URL = режим без очереди: ИИ-задача исполняется в процессе
# запроса, а контракт маршрутов остаётся тем же (202 + task_id + опрос). Это
# штатный режим одиночного процесса, а не урезанный: без брокера долгие вызовы
# физически некуда вынести. С заданным адресом веб-процесс перестаёт держать
# тяжёлые модели — их поднимает воркер (app/tasks.py).
REDIS_URL=redis://redis:6379/0
# Кэш держат в отдельной логической базе, чтобы его можно было сбросить
# (FLUSHDB) вместе с ответами модели, не трогая очередь задач. Пусто = та же
# база, что и очередь.
CACHE_REDIS_URL=redis://redis:6379/1
# Ответ улучшения привязан к конкретному XML схемы, который сам не меняется,
# поэтому держится неделю; описание процесса пользователь переформулирует —
# генерация живёт сутки.
LLM_CACHE_TTL=604800
GENERATION_CACHE_TTL=86400
# Скоринг детерминирован до смены правил, поэтому срок самый длинный: версия
# правил входит в ключ, и устаревший отчёт читаться не будет.
SCORE_CACHE_TTL=2592000
# Заведомо плохой вход (схема, которую контур отверг) запоминается на минуты:
# повтор той же ошибки не должен снова оплачивать вызов провайдера.
NEGATIVE_CACHE_TTL=300

# Параллелизм воркеров. У LLM-очереди он маленький намеренно: тариф провайдера
# даёт один одновременный запрос (GIGACHAT_MAX_CONCURRENT), второй слот нужен на
# разбор ответа и починку структуры, а не на второй вызов модели.
ARQ_MAX_JOBS=2
ARQ_LOCAL_MAX_JOBS=4
# Таймаут задачи LLM-очереди обязан превышать BPMN_GENERATION_BUDGET_SECONDS:
# иначе воркер убивал бы каждую честную генерацию на половине, а пользователь
# получал «сбой» вместо схемы. 1800 = бюджет 900 + очередь к провайдеру и
# два повтора.
AI_LLM_JOB_TIMEOUT=1800
AI_LOCAL_JOB_TIMEOUT=120
# 1 попытка + 2 повтора с задержкой 5 и 25 с (сбой провайдера — состояние
# внешнего сервиса, а не свойства входа).
AI_LLM_JOB_TRIES=3
AI_LOCAL_JOB_TRIES=2
# Задачи в статусе running старше этого срока считаются потерянным воркером:
# они возвращаются в очередь либо закрываются ошибкой, если попытки исчерпаны.
# Значение по умолчанию выводится из AI_LLM_JOB_TIMEOUT (+300 с) и за ним
# следит приложение, поэтому ключ здесь оставлен закомментированным: явное
# число переживает рост таймаута очереди и начинает хоронить живые задачи.
# Раскомментируйте только если знаете, что делаете (ниже AI_LLM_JOB_TIMEOUT —
# предупреждение в лог при старте).
# AI_TASK_STALE_SECONDS=2100
# Через сколько секунд фронтенд опрашивает задачу в первый раз; дальше он
# замедляет опрос сам (2 с → 5 с), сервер это число только подсказывает.
TASK_POLL_SECONDS=2
# Как часто воркер проверяет флаг отмены. Не совпадает с TASK_POLL_SECONDS:
# тот ключ вежливость клиента, а этот — задержка между просьбой отменить и
# прекращением оплаты обращений модели. Поднять его можно, но каждые 10 с
# медленнее означают до 10 минут живущую задачу после нажатия «Отменить».
CANCEL_PROBE_SECONDS=2
# Как часто воркер отмечает своё присутствие в Redis. Отметка живёт на один
# интервал дольше, поэтому интервал и есть окно, за которое healthcheck
# контейнера замечает мёртвый процесс: с дефолтным часом (у arq) «нездоровый»
# воркер выглядел бы живым до получаса после гибели.
AI_WORKER_HEALTH_SECONDS=20

# --- Троттлинг auth-маршрутов (окно 1 час, счётчик локален для процесса) ---
AUTH_LOGIN_PER_IP_EMAIL_MAX=10
AUTH_LOGIN_PER_EMAIL_MAX=30
AUTH_LOGIN_PER_IP_MAX=200
AUTH_REGISTER_PER_IP_MAX=50
AUTH_RESET_PER_EMAIL_MAX=5
AUTH_RESET_PER_IP_MAX=100

# --- Frontend-сборка ---
# Адрес backend, доступный из БРАУЗЕРА пользователя:
REACT_APP_API_URL=http://localhost:8765

# --- Порты локального запуска (python main.py / npm start) ---
# Хост-порты 8000/3000 на рабочей машине заняты сторонними проектами.
BACKEND_PORT=8765
FRONTEND_URL=http://localhost:3456

# --- Специфичные для прогона и переноса данных (обычно задаются в оболочке,
# а не в .env; перечислены, чтобы шаблон покрывал всё читаемое кодом) ---
# Тестовый прогон (tests/conftest.py): своя база, иначе тесты пишут в рабочую.
# TEST_DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@localhost:5432/bpmn_test
# Интеграция с Redis (tests/test_tasks_redis.py): без переменной тесты
# пропускаются, потому что Lua-скрипт бюджета, ключи очереди arq и срок жизни
# значения считает сервер, а не наш код. В CI поднимается redis:7-alpine.
# TEST_REDIS_URL=redis://localhost:6379/0
# Источник для migrate_sqlite_to_postgres.py: переносимая легаси-SQLite.
# SQLITE_URL=sqlite:///./bpmn.db
