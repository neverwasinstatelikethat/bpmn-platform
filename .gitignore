# Секреты и локальная конфигурация — никогда не попадают в индекс
.env
*.pem
*.key

# База данных и артефакты переноса
*.db
*.db-journal
bpmn.db;C
*.sqlite*

# Производные кэши (пересобираются: см. CACHE_METHOD в core/llm_improve.py)
*.pkl
*.npz
core/bpmn_rag_cache.npz.json

# Артефакты прогонов: загрузки и экспорты пользователей живут в static/
# (исходные ассеты возвращаем исключение ниже)
static/*
!static/vkusvill_logo.png

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Frontend
node_modules/
bpmn-constructor/build/
bpmn-constructor/coverage/
npm-debug.log*

# Логи
*.log

# IDE / окружение агентов
.vs/
.vscode/
.idea/
.qoder/

# Служебное Visual Studio
*.user

# Временные базы проверок
_tmp_alembic/

# Отчёты прогонов харнесса: генерируются на каждом запуске
eval/reports/

# Всё, что начинается с подчёркивания: дампы, логи прогонов, черновые каталоги.
# Исключение — __init__.py: под шаблон попадает и маркер пакета, а новый пакет
# без него в индексе просто не импортируется.
_*
!__init__.py
