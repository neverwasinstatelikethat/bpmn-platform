# Шаблон переменных окружения. Скопируйте в .env и заполните реальными
# значениями. Файл .env не должен попадать в систему контроля версий.
# ВАЖНО: ключи, ранее захардкоженные в коде, считайте скомпрометированными
# и выпустите новые.

# --- База данных ---
# Локальная разработка без Docker (SQLite):
# DATABASE_URL=sqlite:///./bpmn.db
# Docker Compose / production (PostgreSQL):
DATABASE_URL=postgresql+psycopg2://bpmn:CHANGE_ME@db:5432/bpmn
# Пароль пользователя БД для docker-compose:
POSTGRES_PASSWORD=CHANGE_ME

# --- JWT ---
# Обязательно для PostgreSQL; сгенерируйте, например:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Почта (приглашения, сброс пароля) ---
# MAIL_FROM обязан быть валидным e-mail (с @): ConnectionConfig валидирует
# формат при импорте main.py, пустое значение ломает запуск. Пока реальный
# SMTP не настроен — оставьте placeholder.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vkusvill.ru
MAIL_PORT=465
MAIL_SERVER=imap.yandex.ru
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- LLM-провайдер (GigaChat, библиотека gigachat) ---
# credentials — base64 от «client_id:client_secret» из личного кабинета Sber Cloud
# (Scope «GIGACHAT_API_PERS» для физлиц, «GIGACHAT_API_CORP» для организаций).
# Значение — только в .env; в репозиторий попадает этот шаблон с CHANGE_ME.
GIGACHAT_CREDENTIALS=CHANGE_ME
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# false отключает проверку TLS: сертификат GigaChat выдан российским УЦ, которого
# нет в доверенных корнях Windows/Alpine. Оставлять false в проде нельзя —
# вместо этого укажите CA-bundle и верните true.
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE_FILE=/path/to/rus-trust-ca.pem
GIGACHAT_MODEL=GigaChat
# Scope GIGACHAT_API_PERS и GIGACHAT_API_B2B разрешают один одновременный
# запрос: лишние параллельные вызовы провайдер отбивает 429. Поднимайте только
# на тарифе с большей параллельностью.
GIGACHAT_MAX_CONCURRENT=1
# Путь к кэшу RAG-индекса (.npz + JSON-манифест). По умолчанию рядом с кодом:
# core/bpmn_rag_cache.npz
# BPMN_RAG_CACHE_FILE=/var/tmp/bpmn_rag_cache.npz

# --- Лимиты ИИ-контура ---
# Максимальный размер BPMN XML в запросах скоринга и улучшения (символов).
AI_MAX_XML_CHARS=1000000
# Максимальный размер загружаемого в реестр .bpmn/.xml файла, байт.
MAX_UPLOAD_BYTES=2000000
# Часовой бюджет ИИ-запросов на пользователя (генерация, скоринг, улучшение).
# Счётчик локален для процесса: при нескольких репликах нужен общий (Redis).
AI_REQUESTS_PER_HOUR=60

# --- Frontend-сборка ---
# Адрес backend, доступный из БРАУЗЕРА пользователя:
REACT_APP_API_URL=http://localhost:8765

# --- Порты локального запуска (python main.py / npm start) ---
# Хост-порты 8000/3000 на рабочей машине заняты сторонними проектами.
BACKEND_PORT=8765
FRONTEND_URL=http://localhost:3456
